# Copy to .env and adjust. Every setting is optional.

# Detected from the default route when empty. Subnets are comma-separated.
LW_INTERFACE=
LW_SUBNETS=

LW_SCAN_INTERVAL=60
LW_OFFLINE_AFTER=300

# auto | arp | neigh
LW_SCAN_METHOD=auto

LW_HOST=0.0.0.0
LW_PORT=8090

# Basic auth for the UI and API: user:password
LW_AUTH=

LW_RESOLVE_HOSTNAMES=true
LW_HISTORY_DAYS=7

# JSON POST for every new device (n8n, Home Assistant, Slack, ...)
LW_WEBHOOK_URL=

# DEBUG | INFO | WARNING | ERROR
LW_LOG_LEVEL=INFO

# Fake household network for trying the UI
LW_DEMO=false

TZ=UTC
